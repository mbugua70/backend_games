PORT=5000

NODE_ENV=development

# Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/backend_games
# MongoDB Atlas (SRV):
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/backend_games?appName=<app-name>

# Comma-separated list of allowed origins. This backend serves several
# unrelated frontends (one per game, plus each game's admin portal), so
# every origin that calls this API must be listed here. The deployed
# server must have its CLIENT_URL env var set on its host to include ALL
# production origins - this file is not read in prod.
CLIENT_URL=http://localhost:5173,http://localhost:5176

LOG_LEVEL=info

# Signs admin dashboard JWTs (see src/utils/jwt.ts). Generate a real random
# value for this in every environment, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h

# How long an admin refresh token stays valid (used by games with a
# refresh-token flow, e.g. ar_basketball).
ADMIN_REFRESH_TOKEN_EXPIRES_IN=7d

# Static shared secret the website must send as the x-api-key header to
# use the feedback module (src/games/feedback) - it has no JWT/admin
# login, so this is its only gate. Generate a real random value, e.g.:
# openssl rand -hex 32
FEEDBACK_API_KEY=replace-with-a-long-random-string
