PORT=5000

NODE_ENV=development

# Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/backend_games
# MongoDB Atlas (SRV):
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/backend_games?appName=<app-name>

# Comma-separated list of allowed origins. This backend serves several
# unrelated frontends (one per game, plus each game's admin portal), so
# every origin that calls this API must be listed here. The deployed
# server must have its CLIENT_URL env var set on its host to include ALL
# production origins - this file is not read in prod.
CLIENT_URL=http://localhost:5173,http://localhost:5176

LOG_LEVEL=info

# Signs admin dashboard JWTs (see src/utils/jwt.ts). Generate a real random
# value for this in every environment, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h

# How long an admin refresh token stays valid (used by games with a
# refresh-token flow, e.g. ar_basketball).
ADMIN_REFRESH_TOKEN_EXPIRES_IN=7d

# Static shared secret the website must send as the x-api-key header to
# use the feedback module (src/games/feedback) - it has no JWT/admin
# login, so this is its only gate. Generate a real random value, e.g.:
# openssl rand -hex 32
FEEDBACK_API_KEY=replace-with-a-long-random-string

# safaricom_ceo's public endpoints (register/questions/sessions) carry no
# org identifier in their URLs, so this slug resolves which single
# Organization that traffic belongs to for this deployment - see
# src/games/safaricom_ceo/services/organization.service.ts. Must match the
# --org slug used with seed:admin:safaricom_ceo.
SAFARICOM_CEO_ORG_SLUG=safaricom-ceo-challenge

# Rate limits for safaricom_ceo's registration/session-start/response-submit/
# session-complete endpoints, and its admin login separately (stricter
# default, since brute-forcing a password is a different threat than a
# busy event's normal traffic).
SAFARICOM_CEO_RATE_LIMIT_WINDOW_MS=60000
SAFARICOM_CEO_RATE_LIMIT_MAX=30
SAFARICOM_CEO_LOGIN_RATE_LIMIT_WINDOW_MS=900000
SAFARICOM_CEO_LOGIN_RATE_LIMIT_MAX=10

# Rate limits for carrefour_balloon's public endpoints (game-config/
# participants/wins) and its admin login separately, same split rationale
# as the SAFARICOM_CEO_* pair above.
CARREFOUR_BALLOON_RATE_LIMIT_WINDOW_MS=60000
CARREFOUR_BALLOON_RATE_LIMIT_MAX=60
CARREFOUR_BALLOON_LOGIN_RATE_LIMIT_WINDOW_MS=900000
CARREFOUR_BALLOON_LOGIN_RATE_LIMIT_MAX=10

# Lifetime of the opaque participant token issued by
# POST /carrefour_balloon/v1/events/:eventId/participants when registration
# is enabled - long enough to cover a full event day.
CARREFOUR_BALLOON_PARTICIPANT_TOKEN_EXPIRES_IN=24h

# Which Organization safaricom_trivia's public (no-org-in-URL) endpoints
# belong to - seed:admin:safaricom_trivia creates it on first run.
SAFARICOM_TRIVIA_ORG_SLUG=safaricom-trivia

# Rate limits for safaricom_trivia's public endpoints (players/sessions)
# and its admin login, same split rationale as the SAFARICOM_CEO_* pair.
SAFARICOM_TRIVIA_RATE_LIMIT_WINDOW_MS=60000
SAFARICOM_TRIVIA_RATE_LIMIT_MAX=30
SAFARICOM_TRIVIA_LOGIN_RATE_LIMIT_WINDOW_MS=900000
SAFARICOM_TRIVIA_LOGIN_RATE_LIMIT_MAX=10

# Lifetime of the player token issued by POST /safaricom_trivia/v1/players.
SAFARICOM_TRIVIA_PLAYER_TOKEN_EXPIRES_IN=6h
